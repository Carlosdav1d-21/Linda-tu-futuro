---
---
<section id="contacto" class="bg-mesh py-24">
  <div class="mx-auto max-w-4xl px-6 md:px-10">
    <div class="aos rounded-3xl border border-slate-100 bg-white p-8 shadow-2xl md:p-14">
      <div class="mb-10 text-center">
        <span class="text-sm font-bold uppercase tracking-widest text-[#2563EB]">Contacto</span>
        <h2 class="mt-3 font-display text-4xl font-bold text-slate-900">¿Lista para empezar?</h2>
        <p class="mt-3 text-slate-500">Completa el formulario y me pondré en contacto contigo en menos de 24 horas.</p>
      </div>

      <form
        id="contact-form"
        action="https://formsubmit.co/lindasep18@gmail.com"
        method="POST"
        class="grid gap-5"
      >
        <input type="hidden" name="_subject" value="Nuevo mensaje desde Linda tu Futuro" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />

        <div class="grid gap-5 md:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700" for="name">Nombre Completo</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Ej. Ana Garcia"
              required
              class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition-all focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700" for="email">Correo Electronico</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="ana@ejemplo.com"
              required
              class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition-all focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100"
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700" for="phone">Telefono (opcional)</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            placeholder="+52 81 0000 0000"
            class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition-all focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700" for="service">Servicio de Interes</label>
          <select
            id="service"
            name="service"
            class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition-all focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100"
          >
            <option value="">Selecciona una opcion</option>
            <option>Seguro para la Mujer</option>
            <option>Proteccion y Ahorro</option>
            <option>Gastos Medicos Mayores</option>
            <option>Plan Personal para el Retiro</option>
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700" for="message">Mensaje (opcional)</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Cuentame un poco sobre tus metas..."
            class="resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition-all focus:border-[#2563EB] focus:ring-2 focus:ring-blue-100"
          ></textarea>
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="mt-2 w-full rounded-2xl bg-[#2563EB] py-4 text-base font-semibold text-white shadow-xl transition-all hover:scale-[1.01] hover:bg-[#1D4ED8]"
        >
          Enviar Mensaje
        </button>
      </form>
    </div>
  </div>
</section>
