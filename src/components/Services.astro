---
const services = [
  {
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
    title: "Seguro para la Mujer",
    desc: "Ahorro y protección específica para padecimientos femeninos y dificultades en el embarazo.",
    bg: "bg-rose-50", iconBg: "bg-rose-100", iconColor: "text-rose-500",
  },
  {
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    title: "Protección y Ahorro",
    desc: "Planes flexibles para asegurar tu patrimonio y alcanzar tus metas financieras a largo plazo.",
    bg: "bg-blue-50", iconBg: "bg-blue-100", iconColor: "text-blue-500",
  },
  {
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
    title: "Gastos Médicos",
    desc: "Cobertura integral para tu tranquilidad ante cualquier eventualidad médica o accidente.",
    bg: "bg-green-50", iconBg: "bg-green-100", iconColor: "text-green-600",
  },
  {
    icon: "M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7",
    title: "Plan de Retiro",
    desc: "Ahorro estratégico con cobertura para un retiro digno y seguro.",
    bg: "bg-purple-50", iconBg: "bg-purple-100", iconColor: "text-purple-600",
  },
];
---
<section id="servicios" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="mb-16 text-center aos">
      <span class="text-sm font-bold uppercase tracking-widest text-[#2563EB]">Nuestros Servicios</span>
      <h2 class="mt-3 font-display text-4xl font-bold text-slate-900 md:text-5xl">Protección diseñada para ti</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-500 text-lg">
        Soluciones integrales que se adaptan a cada etapa de tu vida.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <div class={`aos aos-delay-${i+1} card-lift group rounded-3xl border border-slate-100 ${s.bg} p-7 cursor-default`}>
          <div class={`mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl ${s.iconBg}`}>
            <svg class={`h-6 w-6 ${s.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
            </svg>
          </div>
          <h3 class="mb-2 text-lg font-bold text-slate-900">{s.title}</h3>
          <p class="text-sm leading-relaxed text-slate-600">{s.desc}</p>
          <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-[#2563EB] opacity-0 group-hover:opacity-100 transition-opacity">
            Conocer más
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>