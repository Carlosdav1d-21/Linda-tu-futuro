---
---
<section class="relative min-h-screen bg-mesh flex items-center overflow-hidden pt-28 pb-16">
  <div class="pointer-events-none absolute top-20 right-[8%] h-72 w-72 rounded-full bg-blue-400/6 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-16 left-[5%] h-56 w-56 rounded-full bg-purple-400/5 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-6 md:px-10 w-full">
    <div class="grid items-center gap-12 lg:grid-cols-2">

      <!-- Texto -->
      <div class="flex flex-col gap-7">
        <span class="aos inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 border border-blue-200 px-4 py-1.5 text-sm font-semibold text-[#2563EB]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#2563EB] animate-pulse"></span>
          Confianza y Seguridad
        </span>

        <h1 class="aos aos-delay-1 font-display text-5xl font-bold leading-[1.1] tracking-tight md:text-6xl lg:text-7xl text-slate-900">
          Tu futuro y salud<br>
          en las <span class="text-gradient italic">mejores manos</span>
        </h1>

        <p class="aos aos-delay-2 text-lg text-slate-500 max-w-lg leading-relaxed">
          Asesoría personalizada para mujeres, enfocada en ahorro, protección y tranquilidad para ti y tu familia.
        </p>

        <div class="aos aos-delay-3 flex flex-col sm:flex-row gap-4">
          <a href="#contacto" class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-[#2563EB] px-8 py-4 text-base font-semibold text-white shadow-xl hover:bg-[#1D4ED8] transition-all hover:scale-[1.02]">
            Agenda tu asesoría
            <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#servicios" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-8 py-4 text-base font-semibold text-slate-700 hover:bg-slate-50 transition-all">
            <svg class="h-5 w-5 text-[#2563EB]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Ver cómo trabajo
          </a>
        </div>

        <!-- Stats -->
        <div class="aos aos-delay-4 flex items-center gap-6 pt-4 border-t border-slate-200">
          <div>
            <p class="text-3xl font-bold font-display text-slate-900">
              <span class="counter" data-target="500" data-suffix="+">500+</span>
            </p>
            <p class="text-xs text-slate-500 mt-0.5">Clientes protegidas</p>
          </div>
          <div class="h-10 w-px bg-slate-200"></div>
          <div>
            <p class="text-3xl font-bold font-display text-slate-900">
              <span class="counter" data-target="8" data-suffix="+">8+</span>
            </p>
            <p class="text-xs text-slate-500 mt-0.5">Años de experiencia</p>
          </div>
          <div class="h-10 w-px bg-slate-200"></div>
          <div>
            <p class="text-3xl font-bold font-display text-slate-900">98%</p>
            <p class="text-xs text-slate-500 mt-0.5">Satisfacción</p>
          </div>
        </div>
      </div>

      <!-- Imagen -->
      <div class="aos aos-delay-2 relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm lg:max-w-md">
          <div class="absolute inset-0 rounded-[2.5rem] bg-gradient-to-br from-blue-200/40 to-purple-200/20 rotate-3"></div>
          <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl float">
            <!-- 👇 Reemplaza este src con la foto real de tu hermana -->
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=600&auto=format&fit=crop&q=80"
              alt="Linda — Asesora de seguros"
              class="h-[520px] w-full object-cover object-top"
            />
          </div>
          <!-- Badge inferior -->
          <div class="absolute -bottom-5 -left-5 rounded-2xl bg-white shadow-xl p-4 flex items-center gap-3">
            <div class="flex -space-x-2.5">
              <div class="h-9 w-9 rounded-full bg-blue-200 border-2 border-white"></div>
              <div class="h-9 w-9 rounded-full bg-pink-200 border-2 border-white"></div>
              <div class="h-9 w-9 rounded-full bg-purple-200 border-2 border-white"></div>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">+500 Clientes</p>
              <p class="text-xs text-slate-500">Tranquilidad garantizada</p>
            </div>
          </div>
          <!-- Badge estrella -->
          <div class="absolute -top-4 -right-4 rounded-2xl bg-[#2563EB] p-3 shadow-lg float" style="animation-delay: 1s">
            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>