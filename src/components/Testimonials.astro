---
const testimonials = [
  {
    name: "María R.", role: "Emprendedora", initials: "MR", color: "bg-blue-100 text-blue-700",
    quote: "La asesoría fue súper clara. Por fin entiendo cómo funciona mi seguro de gastos médicos y me siento completamente protegida.",
  },
  {
    name: "Elena G.", role: "Directora Creativa", initials: "EG", color: "bg-purple-100 text-purple-700",
    quote: "Inicié mi plan de retiro con ella y la tranquilidad que me da saber que mi futuro está asegurado no tiene precio.",
  },
  {
    name: "Sofía M.", role: "Madre de familia", initials: "SM", color: "bg-rose-100 text-rose-700",
    quote: "Me ayudó a encontrar el seguro perfecto para mi embarazo. Siempre estuvo atenta a mis dudas y muy paciente.",
  },
];
---
<section id="testimonios" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div class="mb-14 text-center aos">
      <span class="text-sm font-bold uppercase tracking-widest text-[#2563EB]">Testimonios</span>
      <h2 class="mt-3 font-display text-4xl font-bold text-slate-900 md:text-5xl">Lo que dicen mis clientes</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((t, i) => (
        <div class={`aos aos-delay-${i+1} card-lift flex flex-col rounded-3xl border border-slate-100 bg-slate-50 p-8`}>
          <div class="flex gap-0.5 mb-5">
            {[1,2,3,4,5].map(() => (
              <svg class="h-5 w-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <p class="flex-1 text-slate-600 leading-relaxed text-sm mb-6">"{t.quote}"</p>
          <div class="flex items-center gap-3 pt-5 border-t border-slate-200">
            <div class={`h-10 w-10 rounded-full ${t.color} flex items-center justify-center text-sm font-bold`}>
              {t.initials}
            </div>
            <div>
              <p class="font-bold text-slate-900 text-sm">{t.name}</p>
              <p class="text-xs text-slate-400">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>