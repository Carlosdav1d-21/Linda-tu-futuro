---
---
<header class="fixed top-0 z-50 w-full px-4 pt-4 md:px-8">
  <div class="mx-auto max-w-7xl flex items-center justify-between rounded-2xl bg-white/80 backdrop-blur-xl border border-slate-200/60 shadow-lg px-5 py-3">

    <a href="#" class="flex items-center gap-2.5">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#2563EB] shadow-md">
        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <div class="leading-tight">
        <span class="block text-sm font-bold text-slate-900">Linda tu Futuro</span>
        <span class="block text-[11px] text-slate-400">Seguros para la mujer</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7">
      <a href="#servicios"   class="text-sm font-medium text-slate-600 hover:text-[#2563EB] transition-colors">Servicios</a>
      <a href="#sobre-mi"    class="text-sm font-medium text-slate-600 hover:text-[#2563EB] transition-colors">Sobre mí</a>
      <a href="#testimonios" class="text-sm font-medium text-slate-600 hover:text-[#2563EB] transition-colors">Testimonios</a>
      <a href="#contacto"    class="text-sm font-medium text-slate-600 hover:text-[#2563EB] transition-colors">Contacto</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="#contacto" class="hidden md:inline-flex items-center gap-1.5 rounded-xl bg-[#2563EB] px-5 py-2.5 text-sm font-semibold text-white shadow-lg hover:bg-[#1D4ED8] transition-all hover:scale-[1.02]">
        Agendar Consulta
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <button id="menu-btn" class="md:hidden p-1 flex flex-col gap-1.5" aria-label="Menú">
        <span class="block h-0.5 w-5 bg-slate-700 rounded"></span>
        <span class="block h-0.5 w-5 bg-slate-700 rounded"></span>
        <span class="block h-0.5 w-3 bg-slate-700 rounded"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden mt-2 mx-auto max-w-7xl rounded-2xl bg-white/95 backdrop-blur-xl border border-slate-200/60 shadow-xl px-6 py-5">
    <nav class="flex flex-col gap-4">
      <a href="#servicios"   class="text-sm font-medium text-slate-700 hover:text-[#2563EB]">Servicios</a>
      <a href="#sobre-mi"    class="text-sm font-medium text-slate-700 hover:text-[#2563EB]">Sobre mí</a>
      <a href="#testimonios" class="text-sm font-medium text-slate-700 hover:text-[#2563EB]">Testimonios</a>
      <a href="#contacto"    class="text-sm font-medium text-slate-700 hover:text-[#2563EB]">Contacto</a>
      <a href="#contacto" class="mt-1 inline-flex items-center justify-center rounded-xl bg-[#2563EB] px-5 py-2.5 text-sm font-semibold text-white">
        Agendar Consulta
      </a>
    </nav>
  </div>
</header>